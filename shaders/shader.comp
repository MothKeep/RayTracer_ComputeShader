#version 450

struct Material{
  uint type; //0 - lambertian, 1 - metal, 2 - glass
  vec3 value1; //albedo
  float value2; //fuzz / refraction index
};

struct Sphere{
  vec3 center;
  float radius;
  uint materialIndex;
};


//--------
//bindings
//--------
layout(local_size_x = 16, local_size_y = 8) in; //1 invocation per pixel in 16 by 8 groups

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;

layout(binding = 1) uniform RenderCallInfo{
  uint samplesPerPixel;
}renderCallInfo;

layout(binding = 2) uniform SceneInfo{
  uint spheresTotal;
  Sphere spheres[500];
  Material materials[500];
}sceneInfo;

//-------
//structs
//-------
struct Ray{
  vec3 origin;
  vec3 direction;
};

struct Viewport{
  float height;
  float width;

  vec3 upperLeft;
  vec3 camForward;
  vec3 camLeft;
  vec3 camUp;

  vec3 horizontal;
  vec3 vertical;
};

struct Camera{
  float fov;
  vec3 lookFrom;
  vec3 lookAt;
  vec3 up;
};

struct HitRecord{
  bool doesHit;
  bool frontFace;
  vec3 hitPoint;
  vec3 outNormal;
  uint materialIndex;
  float t;
};

struct ScatterRecord{
  bool doesScatter;
  vec3 direction;
  vec3 attenuation;
};

//---------------------
//function declarations
//---------------------
void initViewport(vec2 imgSize, float focalLength);
Ray getRay(float u, float v);
vec3 rayAt(Ray ray, float t);

vec3 rayColor(Ray ray);
vec3 skyColor(Ray ray);

HitRecord worldHit(Ray r, float tMin);
HitRecord hitSphere(Sphere sphere, Ray ray, float tMin, float tMax);
ScatterRecord scatter(HitRecord hitRecord, Ray ray);
ScatterRecord lambertianScatter(HitRecord hitRecord, Ray ray);
ScatterRecord metalScatter(HitRecord hitRecord, Ray ray);
ScatterRecord dielectricScatter(HitRecord hitRecord, Ray ray);

bool isVectorNearZero(vec3 vec);
float reflectance(float cosine, float eta);

uint hash(uint x);
float random();
float randomInInterval(float min, float max);
vec3 randomVector(float min, float max);
vec3 randomUnitVector();

//---------
//constants
//---------
Camera cam = Camera(20.0, vec3(13, 2, 3), vec3(0,0,0), vec3(0,1,0));
Viewport viewport;
const uint maxDepth = 50;
const float maxDistance = 10000.0f;

//----
//main
//----
void main(){
  //"global"
  const vec2 imgSize = vec2(imageSize(outputImage));
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if(any(greaterThanEqual(pixel, size)){
    return;
  }

  const float aspectRatio = imgSize.x / imgSize.y;
  initViewport(imgSize, 1.0);
  
  const uint samplesRoot = uint(sqrt(float(renderCallInfo.samplesPerPixel)));
  const uint samplesPerPixel = samplesRoot * samplesRoot;

  //"local"
  vec3 summedColor = vec3(0,0,0);
  
  for(uint i=0; i<samplesPerPixel; i++){ //sampling Square
    float u = (float(pixel.x) + float(i % samplesRoot) / float(samplesRoot)) / imgSize.x; 
    float v = (float(pixel.y) + float(i / samplesRoot) / float(samplesRoot)) / imgSize.y;
  
    Ray ray = getRay(u, v);
      
    summedColor += rayColor(ray) / float(samplesPerPixel);
  }
    
  imageStore(outputImage, pixel, vec4(summedColor, 1.0));
}

//---------
//functions
//---------
void initViewport(vec2 imgSize, float focalLength){
  viewport.height = 2.0f * tan(radians(cam.fov) * 0.5);
  viewport.width = viewport.height * imgSize.x / imgSize.y;
  viewport.camForward = normalize(cam.lookAt - cam.lookFrom);
  viewport.camLeft = normalize(cross(viewport.camForward, cam.up));
  viewport.camUp = normalize(cross(viewport.camLeft, viewport.camForward));
  
  viewport.horizontal = -viewport.camLeft * viewport.width;
  viewport.vertical = -viewport.camUp * viewport.height;

  viewport.upperLeft = cam.lookFrom + viewport.camForward * focalLength
                      - viewport.horizontal * 0.5 - viewport.vertical * 0.5;
}

Ray getRay(float u, float v){
  Ray ray;
  ray.origin = cam.lookFrom;
  vec3 pixelPos = viewport.upperLeft + viewport.horizontal * u + viewport.vertical * v;
  ray.direction = normalize(pixelPos - ray.origin);
  return ray;
}

vec3 rayAt(Ray ray, float t){
  return ray.origin + t * ray.direction;
}

vec3 rayColor(Ray ray){
  vec3 color = vec3(1.0);
  vec3 light = vec3(1.0);

  for(uint i=0; i<maxDepth; i++){
    HitRecord hitRecord = worldHit(ray, 0.0001);
    
    if(!hitRecord.doesHit){
      light = skyColor(ray);
      break;
    }

    ScatterRecord scatterRecord = scatter(hitRecord, ray);
    if(!scatterRecord.doesScatter){
      break;
    }

    ray.origin = hitRecord.hitPoint + scatterRecord.direction * 0.0001;
    ray.direction = normalize(scatterRecord.direction);
    color = color * scatterRecord.attenuation;
  }

  color = color * light;
  color = sqrt(color);

  return color;
}

vec3 skyColor(Ray ray){
  vec3 v = ray.direction;
  float t = 0.5 * (v.y + 1.0);

  return mix(vec3(0.7), vec3(0.2, 0.4, 0.7), t);
}

HitRecord worldHit(Ray ray, float tMin){
  HitRecord final;
  final.doesHit = false;
  final.t = maxDistance;

  for(uint i=0; i<sceneInfo.spheresTotal; i++){
    HitRecord current = hitSphere(sceneInfo.spheres[i], ray, tMin, final.t);
    if(current.doesHit){ 
      final = current;
    }
  }
  return final;
}

HitRecord hitSphere(Sphere sphere, Ray ray, float tMin, float tMax){
  HitRecord hitRecord;
  const vec3 oc = sphere.center - ray.origin;
  const float a = dot(ray.direction, ray.direction);
  const float h = dot(ray.direction, oc);
  const float c = dot(oc, oc) - sphere.radius * sphere.radius;
  const float discrimant = h*h  - a*c;

  if(discrimant < 0){
    hitRecord.doesHit = false;
    return hitRecord;
  } 
  
  const float sqrtd = sqrt(discrimant);
  const float t1 = (h - sqrtd) / a;
  const float t2 = (h + sqrtd) / a;
 
  float t;
  if(t1 > tMin && t1 < tMax){
    if(t2 > tMin && t2 < t1)
      t = t2;
    else
      t = t1;
  }
  else if (t2 > tMin && t2 < tMax){
    t = t2;
  }
  else{
    hitRecord.doesHit = false;
    return hitRecord;
  }
  
  hitRecord.hitPoint = rayAt(ray,t);
  hitRecord.outNormal = normalize(hitRecord.hitPoint - sphere.center);
  
  if(dot(ray.direction, hitRecord.outNormal) < 0.0f)
    hitRecord.frontFace = true;
  else
    hitRecord.frontFace = false;

  hitRecord.doesHit = true;
  hitRecord.t = t;
  hitRecord.materialIndex = sphere.materialIndex;
  return hitRecord;
}

ScatterRecord scatter(HitRecord hitRecord, Ray ray){
  ScatterRecord scatterRecord;

  uint type = sceneInfo.materials[hitRecord.materialIndex].type;
  switch(type){
    case 0:
      scatterRecord = lambertianScatter(hitRecord, ray);
      break;
    case 1:
      scatterRecord = metalScatter(hitRecord, ray);
      break;
    case 2:
      scatterRecord = dielectricScatter(hitRecord, ray);
      break;
    default:
      scatterRecord = lambertianScatter(hitRecord, ray);
      break;
  }

  return scatterRecord;
}

ScatterRecord lambertianScatter(HitRecord hitRecord, Ray ray){
  ScatterRecord scatterRecord;
  scatterRecord.doesScatter = true;

  vec3 scatterDirection = normalize(hitRecord.outNormal + randomUnitVector());
  Material mat = sceneInfo.materials[hitRecord.materialIndex];

  if(isVectorNearZero(scatterDirection)){
    scatterDirection = hitRecord.outNormal;
  }

  scatterRecord.direction = scatterDirection;
  scatterRecord.attenuation = vec3(max(mat.value1, vec3(0.001)));

  return scatterRecord;
}

ScatterRecord metalScatter(HitRecord hitRecord, Ray ray){
  ScatterRecord scatterRecord;
  Material mat = sceneInfo.materials[hitRecord.materialIndex];

  vec3 reflected = reflect(ray.direction, hitRecord.outNormal);
  reflected = normalize(reflected) + (mat.value2 * randomUnitVector()); //fuzziness
  
  scatterRecord.direction = reflected;
  scatterRecord.attenuation = vec3(max(mat.value1, vec3(0.001)));
  
  if(dot(reflected, hitRecord.outNormal) > 0)
    scatterRecord.doesScatter = true;
  else 
    scatterRecord.doesScatter = false;
  
  return scatterRecord;
}

ScatterRecord dielectricScatter(HitRecord hitRecord, Ray ray) {
  ScatterRecord scatterRecord;
  Material mat = sceneInfo.materials[hitRecord.materialIndex];

  scatterRecord.doesScatter = true;
  scatterRecord.attenuation = mix(vec3(1.0), max(mat.value1, vec3(0.5)), 0.8);

  float eta;
  vec3 N;
  if(hitRecord.frontFace){
    eta = 1/mat.value2;
    N = hitRecord.outNormal;
  }
  else{
    eta = mat.value2;
    N = -hitRecord.outNormal;

  }
  vec3 I = normalize(ray.direction);

  float cosTheta = min(dot(-I, N), 1.0);
  float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

  bool cannotRefract = eta * sinTheta > 1.0;

  vec3 direction;
  if (cannotRefract || reflectance(cosTheta, eta) > random())
    direction = reflect(I, N);
  else
    direction = refract(I, N, eta);

  scatterRecord.direction = direction;
  return scatterRecord;
}

float reflectance(float cosine, float eta){
  float r = pow((1.0f - eta) / (1.0f + eta), 2.0f);
  return r + (1.0f - r) * pow(1.0f - cosine, 5.0f);
}

bool isVectorNearZero(vec3 vec) {
  const float s = 1e-8;
  return abs(vec.x) < s && abs(vec.y) < s && abs(vec.z) < s;
}
//random
uint hash(uint x) {
  x += (x << 10u);
  x ^= (x >>  6u);
  x += (x <<  3u);
  x ^= (x >> 11u);
  x += (x << 15u);
  return x;
}

uint currentRandomOffset = 0;

float random() {
  currentRandomOffset += 1;
  const uvec4 v = floatBitsToUint(vec4(gl_GlobalInvocationID.xy, 100, currentRandomOffset));

  uint m = hash(v.x ^ hash(v.y) ^ hash(v.z) ^ hash(v.w));
  m &= 0x007FFFFFu;
  m |= 0x3F800000u;
  return uintBitsToFloat(m) - 1.0f;
}

float randomInInterval(float min, float max) {
  return random() * (max - min) + min;
}

vec3 randomVector(float min, float max) {
  return vec3(randomInInterval(min, max), randomInInterval(min, max), randomInInterval(min, max));
}

vec3 randomUnitVector() {
  return normalize(randomVector(-1.0f, 1.0f));
}
